# ---------------------------------------------------------------------------
# Secure GPT — configuration template.
# Copy to .env and fill in, or run `make bootstrap` to generate the secrets.
# .env is gitignored and written mode 600. Never commit it.
# ---------------------------------------------------------------------------

# --- Google AI Studio (the only outbound data path in this stack) ----------
# Create / rotate at https://aistudio.google.com/apikey
# Only used when LITELLM_CONFIG points at config.aistudio.yaml. Use a key on
# a BILLED project: on the free tier Google may use prompts to improve its
# products; on the paid tier it does not.
GEMINI_API_KEY=AIza-CHANGEME

EMBEDDING_MODEL=gemini-embedding-001

# --- Secrets (generated by `make bootstrap`) -------------------------------
LITELLM_MASTER_KEY=sk-CHANGEME
LITELLM_SALT_KEY=CHANGEME
LITELLM_UI_PASSWORD=CHANGEME
OPENWEBUI_SECRET_KEY=CHANGEME
POSTGRES_PASSWORD=CHANGEME

# --- Provider ------------------------------------------------------------
# ./litellm/config.vertex.yaml    Vertex AI, EU residency, IAM auth (default)
# ./litellm/config.aistudio.yaml  Google AI Studio, global endpoint, API key
# Switch with `make use-vertex` / `make use-aistudio`.
# Chat runs in the `eu` multi-region; embeddings in a single EU region.
# See README ("Why two locations").
LITELLM_CONFIG=./litellm/config.vertex.yaml
VERTEX_PROJECT=your-project-id
VERTEX_EMBED_LOCATION=europe-west1
VERTEX_LOCATION=eu

# --- Gateway ceilings ------------------------------------------------------
# Blast-radius caps on the SHARED frontend keys, not per-user quotas (README).
# Chat and embeddings hold separate keys so bulk document indexing can never
# starve interactive chat.
CHAT_RPM_LIMIT=300
CHAT_PARALLEL=20
EMBED_RPM_LIMIT=600
EMBED_PARALLEL=8

# --- Bind addresses (127.0.0.1 = not reachable from the LAN) ---------------
OPENWEBUI_BIND=127.0.0.1:3000
LITELLM_BIND=127.0.0.1:4000

# --- OpenWebUI admin account (created by scripts/provision.sh) -------------
ADMIN_NAME="Change Me"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGEME

# --- Demo ADK agent -------------------------------------------------------
ADK_AGENT_MODEL=gemini-3.8-flash
AGENT_RPM_LIMIT=300
AGENT_PARALLEL=10

# --- Issued automatically by scripts/provision.sh; leave blank ------------
OPENWEBUI_CHAT_KEY=
OPENWEBUI_EMBED_KEY=
ADK_AGENT_LITELLM_KEY=
# One per registered A2A agent, named A2A_KEY_<AGENT_NAME_UPPER_SNAKE>.
# Bound to the agent via agent_id: it is the key direct A2A clients use, it
# gives the agent its own spend line, and its existence is what makes the
# LiteLLM Agents page show "Active" instead of "Needs Setup".
A2A_KEY_WEATHER_TIME_AGENT=

# --- Deployment target: local | gcp ---------------------------------------
TARGET=local

# --- Google Cloud target ---------------------------------------------------
# Only used when TARGET=gcp. `make target-gcp` switches; `make up` deploys.
GCP_PROJECT=your-project-id
GCP_REGION=europe-west1
GCP_SQL_INSTANCE=secure-gpt-db
GCP_SQL_TIER=db-g1-small
GCP_SA=secure-gpt-run
GCP_AR_REPO=secure-gpt
# Where Agent Runtime hosts the ADK agent (defaults to GCP_REGION).
# all = reachable but key-protected; internal = VPC-only (see README)
GCP_LITELLM_INGRESS=all
# true disables Cloud Run's invoker IAM check on the UI, leaving Open WebUI's
# own login as the gate. false keeps IAM and needs a tunnel to reach it.
GCP_OPENWEBUI_PUBLIC=true
GCP_AGENT_LOCATION=europe-west1
AGENT_APP_NAME=weather_time_agent
AGENT_RUNTIME_NAME=secure-gpt-weather-time-agent

# Filled in by the deploy scripts; leave blank.
GCP_LITELLM_URL=
GCP_OPENWEBUI_URL=
GCP_AGENT_ENGINE_RESOURCE=
# Provisioned per target: the plain names hold the local stack's keys, the
# GCP_ ones the Cloud Run stack's. Each target has its own key database.
GCP_OPENWEBUI_CHAT_KEY=
GCP_OPENWEBUI_EMBED_KEY=
GCP_ADK_AGENT_LITELLM_KEY=
GCP_A2A_KEY_WEATHER_TIME_AGENT=

# --- Sign in with Google (./scripts/google-oauth.sh) -----------------------
# Left blank, Open WebUI falls back to password login only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ENABLE_OAUTH_SIGNUP=true
# Who may sign in at all. Comma-separated; '*' allows any domain.
OAUTH_ALLOWED_DOMAINS=example.com
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
# Keep the password form available as a way back in.
ENABLE_LOGIN_FORM=true
WEBUI_URL=http://localhost:3000
